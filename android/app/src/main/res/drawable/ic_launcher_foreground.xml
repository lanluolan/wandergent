<?xml version="1.0" encoding="utf-8"?>
<!--
  The mark is what the app produces: stops in visiting order, joined by a route.

  Geometry notes, because adaptive icons crop harder than they look. The viewport is
  108dp but a launcher may mask anything outside a 66dp circle centred at 54,54, so every
  path here stays within about 28dp of that centre. The pin's hole is cut with evenOdd in
  the same path rather than painted in the background colour, so the shape also works as
  the Android 13+ monochrome layer, where the system supplies the colour and only alpha
  survives.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The route, rising left to right. -->
    <path
        android:pathData="M36,72 C36,62 47,64 50,55 C53,47 57,45 62,45"
        android:strokeColor="#9FF0F3"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Where the day starts. -->
    <path
        android:pathData="M30,72 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0 Z"
        android:fillColor="#9FF0F3" />

    <!-- Where it ends: pin with the hole cut out of the same path. -->
    <path
        android:fillType="evenOdd"
        android:fillColor="#FFDF9B"
        android:pathData="M66,58 C60,50 55,45 55,39 A11,11 0 1,1 77,39 C77,45 72,50 66,58 Z
                          M61.5,38 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0 Z" />
</vector>
