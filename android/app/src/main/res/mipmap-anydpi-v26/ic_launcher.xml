<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive only, with no legacy PNG fallback. Adaptive icons landed in API 26 and minSdk
  is 26, so every device that can install this app can render this one. That keeps the
  icon as a single vector instead of five bitmap densities.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
