<?xml version="1.0" encoding="utf-8"?>
<!--
  The release posture: HTTPS only, no exceptions.

  Dev hosts live in `src/debug/res/xml/network_security_config.xml`, which replaces this
  file in debug builds. Talking to a dev machine is a debug-build affordance, so the
  exemption belongs there and nowhere else. Naming hosts here was worse than useless:
  `<domain>` matches one host at a time and cannot express "any machine on my Wi-Fi", so
  the documented LAN setup failed with CLEARTEXT NOT PERMITTED on any API 28+ phone.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
