<?xml version="1.0" encoding="utf-8"?>
<!--
  What may leave the device when Android copies app data.

  `allowBackup="false"` already stops cloud backup, but not device-to-device transfer on
  Android 12+, which is opt-out only through this file. The session token is excluded from
  both: it is a bearer credential in plain DataStore, and a copy on a second device is a
  second signed-in session nobody revoked.

  Everything else stays transferable on purpose. The library and the transcript are the
  user's own content, and the new device simply asks them to sign in again.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/session.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/session.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
