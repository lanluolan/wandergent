<?xml version="1.0" encoding="utf-8"?>
<!--
  The dark counterpart. Only reached when the *system* is in dark mode, which is a real
  limitation: the in-app Light/Dark/System setting lives in DataStore and cannot be read
  before the window exists, so someone who forces dark on a light phone still gets one light
  frame. Fixing that properly would mean persisting the choice somewhere the framework can
  read synchronously; it is not worth a second source of truth for one frame.
-->
<resources>
    <style name="Theme.Wandergent" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
