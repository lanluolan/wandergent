# Editor defaults, applied before any per-editor setting.
# Matters more than usual here: the repo is developed on Windows but CI and any
# container run on Linux, so line endings are pinned rather than left to the OS.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
indent_size = 4

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.md]
indent_size = 2
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.{bat,cmd}]
# Windows batch files break if the shell sees LF.
end_of_line = crlf

[gradlew]
end_of_line = lf

[Makefile]
indent_style = tab
