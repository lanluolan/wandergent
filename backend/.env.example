# Copy to .env and fill in the API keys.

# OpenAI API key.
OPENAI_API_KEY=
# OpenAI API endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1
# Model ID available to your API account.
OPENAI_MODEL=gpt-5.6-luna

# Google Maps key for server-side place and route lookups.
GOOGLE_MAPS_API_KEY=
# Optional key for interactive maps in the app; restrict it to Maps JavaScript API.
GOOGLE_MAPS_BROWSER_KEY=

# Owner-scoped, text-free feedback snapshots (30-day retention).
FEEDBACK_DB_PATH=wandergent-feedback.db

# Optional, content-free OTLP/HTTP JSON export to the Phoenix collector relay.
# With compose.observability.yaml: http://127.0.0.1:4318/v1/traces
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# Optional workspace-relative trace artifacts; e.g. backend/.traces (maximum 100 files).
TRACE_DIRECTORY=
# Optional per-model [input, cached input, output] USD / million tokens, as JSON.
# Missing rates or missing usage means unknown cost; Maps fees are excluded.
TRACE_MODEL_PRICES={}
