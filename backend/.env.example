# Copy to .env and fill in the API keys.

# OpenAI API key.
OPENAI_API_KEY=
# OpenAI API endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1
# Model ID available to your API account.
OPENAI_MODEL=gpt-5.6-luna

# Google Maps key for server-side place and route lookups.
GOOGLE_MAPS_API_KEY=
# Optional key for interactive maps in the app; restrict it to Maps JavaScript API.
GOOGLE_MAPS_BROWSER_KEY=
