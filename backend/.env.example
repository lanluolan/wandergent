# Copy to .env and fill in real values; .env is not committed.

# ---- LLM ----
# Any OpenAI-compatible endpoint. Defaults below are what the project actually runs on
# (Xiaomi MiMo); switching providers is these three lines and no code.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.xiaomimimo.com/v1
OPENAI_MODEL=mimo-v2.5-pro

# Optional model routing. The first turn of a run only reads the request and picks
# tool arguments -- it is forced to emit a tool call and so cannot write the plan --
# which a cheaper model handles fine. Empty (the default) disables routing, because
# the right name is endpoint-specific and a wrong one fails every request.
# Measured and left off: see decisions.md "Model routing: built, measured, and left off".
# e.g. mimo-v2.5 on the MiMo endpoint, gpt-4o-mini alongside a larger OpenAI model.
# FAST_MODEL=

# ---- Timeouts and loop bounds (optional, defaults shown) ----
# TOOL_TIMEOUT_SECONDS=8
# LLM_TIMEOUT_SECONDS=60
# MAX_TOOL_ROUNDS=4
# Room for one reply. The endpoint's own default (4k) cuts a long itinerary off
# mid-JSON. Raise this before suspecting the model of malformed output on long trips.
# LLM_MAX_OUTPUT_TOKENS=16384

# ---- Later phases (can stay empty for now) ----
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/wandergent
# REDIS_URL=redis://localhost:6379/0

# ---- Tool APIs ----
# Weather uses Open-Meteo, which needs no key -- nothing to set here.
#
# Maps: one server-side Google key, enabled for Geocoding, Places (New), Routes and
# Maps Static. It stays on the server -- the app receives rendered map images from this
# backend rather than talking to Google, so nothing is shipped in the APK and no Google
# Play services are required on device. Empty disables the maps tools.
GOOGLE_MAPS_API_KEY=
#
# A second key, for the one surface that cannot stay server-side: the interactive map
# page runs the Maps JavaScript API in the user's WebView, so its key is delivered to
# the device. Restrict this one to **Maps JavaScript API only**, so a leak cannot be
# spent on Places or Routes. Empty falls back to the key above and warns on every
# request -- acceptable on a dev device, not beyond one.
# GOOGLE_MAPS_BROWSER_KEY=

# --- Mail, for password reset -------------------------------------------------------
# Leave SMTP_HOST empty and reset codes are written to the log instead of sent. That is
# fine on a laptop and NOT fine on a deployed server -- the boot log says so every start.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587            # 465 switches to implicit TLS; anything else uses STARTTLS
# SMTP_USERNAME=you@example.com
# SMTP_PASSWORD=
# SMTP_FROM=Wandergent <you@example.com>

# The ceiling on planning runs per day, across everyone. This is the only limit that
# bounds the bill: per-account limits cannot, because accounts are free and unlimited.
# MAX_PLANS_PER_DAY=200
